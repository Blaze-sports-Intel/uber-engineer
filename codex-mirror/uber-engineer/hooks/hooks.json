          ],
          "file_pattern": "skills/cloud-development/**"
        },
        "command": "python3 ${CLAUDE_PLUGIN_ROOT}/skills/cloud-development/scripts/validate_skill.py",
        "description": "Validate cloud-development skill scaffold after edits.",
        "continue_on_failure": true
      },
      {
        "matcher": {
          "tool_name": [
            "Write",
            "Edit"
          ],
          "file_pattern": "skills/ai-ml-development/**"
        },
        "command": "python3 ${CLAUDE_PLUGIN_ROOT}/skills/ai-ml-development/scripts/validate_skill.py",
        "description": "Validate ai-ml-development skill scaffold after edits.",
        "continue_on_failure": true
      },
      {
        "matcher": {
          "tool_name": [
            "Write",
            "Edit"
          ],
          "file_pattern": "skills/blockchain-development/**"
        },
        "command": "python3 ${CLAUDE_PLUGIN_ROOT}/skills/blockchain-development/scripts/validate_skill.py",
        "description": "Validate blockchain-development skill scaffold after edits.",
