{
  "$schema": "https://code.claude.com/schemas/hooks-v1.json",
  "version": 1,
  "hooks": {
    "PostToolUse": [
      {
        "matcher": {
          "tool_name": [
            "Write",
            "Edit"
          ],
          "file_pattern": "skills/frontend-development/**"
        },
        "command": "python3 ${CLAUDE_PLUGIN_ROOT}/skills/frontend-development/scripts/validate_skill.py",
        "description": "Validate frontend-development skill scaffold after edits.",
        "continue_on_failure": true
      },
      {
        "matcher": {
          "tool_name": [
            "Write",
            "Edit"
          ],
          "file_pattern": "skills/backend-development/**"
        },
