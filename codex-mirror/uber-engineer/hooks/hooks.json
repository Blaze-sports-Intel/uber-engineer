      {
        "matcher": {
          "tool_name": [
            "Write",
            "Edit"
          ],
          "file_pattern": "skills/database-development/**"
        },
        "command": "python3 ${CLAUDE_PLUGIN_ROOT}/skills/database-development/scripts/validate_skill.py",
        "description": "Validate database-development skill scaffold after edits.",
        "continue_on_failure": true
      },
      {
        "matcher": {
          "tool_name": [
            "Write",
            "Edit"
          ],
          "file_pattern": "skills/embedded-systems-development/**"
        },
        "command": "python3 ${CLAUDE_PLUGIN_ROOT}/skills/embedded-systems-development/scripts/validate_skill.py",
