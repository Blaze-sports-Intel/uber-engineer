        "continue_on_failure": true
      },
      {
        "matcher": {
          "tool_name": [
            "Write",
            "Edit"
          ],
          "file_pattern": "skills/security-development/**"
        },
        "command": "python3 ${CLAUDE_PLUGIN_ROOT}/skills/security-development/scripts/validate_skill.py",
        "description": "Validate security-development skill scaffold after edits.",
        "continue_on_failure": true
      },
      {
        "matcher": {
          "tool_name": [
            "Write",
            "Edit"
          ],
          "file_pattern": "skills/ar-vr-development/**"
        },
        "command": "python3 ${CLAUDE_PLUGIN_ROOT}/skills/ar-vr-development/scripts/validate_skill.py",
        "description": "Validate ar-vr-development skill scaffold after edits.",
        "continue_on_failure": true
      },
      {
        "matcher": {
          "tool_name": [
            "Write",
            "Edit"
          ],
          "file_pattern": "skills/data-science-development/**"
        },
        "command": "python3 ${CLAUDE_PLUGIN_ROOT}/skills/data-science-development/scripts/validate_skill.py",
        "description": "Validate data-science-development skill scaffold after edits.",
        "continue_on_failure": true
      },
      {
        "matcher": {
          "tool_name": [
            "Write",
            "Edit"
          ],
          "file_pattern": "skills/web-development/**"
        },
        "command": "python3 ${CLAUDE_PLUGIN_ROOT}/skills/web-development/scripts/validate_skill.py",
        "description": "Validate web-development skill scaffold after edits.",
        "continue_on_failure": true
      },
      {
        "matcher": {
          "tool_name": [
            "Write",
            "Edit"
          ]
        },
        "command": "python3 ${CLAUDE_PLUGIN_ROOT}/scripts/check_definition_of_done.py",
        "description": "After any write, remind about the four-state rule (loading/error/empty/populated).",
        "continue_on_failure": true
      }
    ],
    "PreToolUse": [
      {
        "matcher": {
          "tool_name": [
            "Bash"
          ],
          "command_pattern": "rm -rf|DROP TABLE|DROP DATABASE|TRUNCATE"
        },
        "command": "python3 ${CLAUDE_PLUGIN_ROOT}/scripts/destructive_action_guard.py",
        "description": "Block destructive actions without explicit user confirmation.",
        "continue_on_failure": false
      },
      {
        "matcher": {
          "tool_name": [
            "Bash"
          ],
          "command_pattern": "git push --force|git push -f"
        },
        "command": "python3 ${CLAUDE_PLUGIN_ROOT}/scripts/destructive_action_guard.py",
        "description": "Block force-push without explicit user confirmation.",
        "continue_on_failure": false
      }
    ],
    "Stop": [
      {
        "matcher": {},
        "command": "python3 ${CLAUDE_PLUGIN_ROOT}/scripts/ship_auditor_reminder.py",
        "description": "Remind that 200 OK is not the same as visible correct output.",
        "continue_on_failure": true
      }
    ]
  }
}
