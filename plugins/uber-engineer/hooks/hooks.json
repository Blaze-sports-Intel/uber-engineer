        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/skills/frontend-development/scripts/validate_skill.py",
            "timeout": 60
          }
        ],
        "description": "Validate frontend-development skill scaffold after edits."
