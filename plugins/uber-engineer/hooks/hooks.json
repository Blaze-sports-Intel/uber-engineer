{
  "$schema": "https://code.claude.com/schemas/hooks-v1.json",
  "description": "uber-engineer plugin hooks: skill validators (PostToolUse), destructive-action guards (PreToolUse), and ship-auditor reminder (Stop).",
  "hooks": {
