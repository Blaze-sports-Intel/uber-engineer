      "skills/backend-development",
      "skills/full-stack-development",
      "skills/mobile-development",
      "skills/game-development",
      "skills/devops-and-infrastructure",
      "skills/api-development",
      "skills/database-development",
      "skills/embedded-systems-development",
      "skills/cloud-development",
      "skills/ai-ml-development",
      "skills/blockchain-development",
      "skills/test-and-quality-assurance",
      "skills/security-development",
      "skills/ar-vr-development",
      "skills/data-science-development",
