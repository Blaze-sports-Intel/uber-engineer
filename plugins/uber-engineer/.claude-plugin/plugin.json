{
  "$schema": "https://code.claude.com/schemas/plugin-v1.json",
  "name": "uber-engineer",
  "version": "1.0.0",
  "description": "Production-grade engineering plugin for Claude Code, Cowork, and Codex. 17 discipline skills (frontend, backend, full-stack, mobile, game, devops, API, db, embedded, cloud, AI/ML, blockchain, QA, security, AR/VR, data science, web), 4 agents, 8 hooks, 17 slash commands, and MCP wiring for Supabase, GitHub, Cloudflare, Stripe, PostHog, Context7, Playwright, and Chrome DevTools.",
  "author": "Austin Humphrey (humphrey.austin20@gmail.com)",
  "license": "MIT",
  "homepage": "https://github.com/Blaze-sports-Intel/uber-engineer",
  "repository": "https://github.com/Blaze-sports-Intel/uber-engineer",
  "keywords": [
    "engineering",
    "fullstack",
    "devops",
    "uber-engineer",
    "blaze-sports-intel",
    "frontend",
    "backend",
    "mobile",
    "game",
    "ai-ml",
    "blockchain",
    "security",
    "qa",
    "data-science",
    "marketplace"
  ],
